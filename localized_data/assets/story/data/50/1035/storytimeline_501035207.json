{
  "no_wrap": true,
  "text_block_list": [
    {
      "name": "Монолог",
      "text": "Наконец наступает день Такарадзука<n>Кинэн."
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Та-а-ак! Заряжаемся на<n>искромётный забег!"
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Хаяхиде — сильная соперница, зато у<n> меня\nстрасти хоть отбавляй!"
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Обещаю, в этом забеге будет<n> на что посмотреть,\nтренер!",
      "choice_data_list": [
        "Иди и покажи им!",
        "Иди и покажи им!"
      ]
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Ага! До встречи!"
    },
    {
      "name": "Бива Хаяхиде",
      "text": "...Тикет."
    },
    {
      "name": "Уиннинг Тикет",
      "text": "О, Хаяхиде! Удачи нам обеим!"
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Давай устроим отличный забег, чтобы<n> зрители\nахнули!"
    },
    {
      "name": "Бива Хаяхиде",
      "text": "Чтобы зрители ахнули... Понятно."
    },
    {
      "name": "Уиннинг Тикет",
      "text": "Ага! Так что не поддавайся!"
    },
    {
      "name": "Бива Хаяхиде",
      "text": "Разумеется. И тебе не советую."
    }
  ],
  "title": "Перед Такарадзука Кинэн"
}
